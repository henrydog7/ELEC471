  codeblock {
    id			    435
    slsfobj		    40
    code		    "function gear_ratio = getGearRatio(active_gear, gear_ratios, rev_ratio, prev_gear_ratio) \n    if (prev"
    "_gear_ratio == 0) \n        prev_gear_ratio = gear_ratios(1); % default to first\n    end\n    if (active_gear == "
    "-1) \n        gear_ratio = rev_ratio;\n    elseif (active_gear == 0)\n        gear_ratio = prev_gear_ratio; \n    "
    "elseif (active_gear <= length(gear_ratios))\n        gear_ratio = gear_ratios(active_gear);\n    else\n        gea"
    "r_ratio = prev_gear_ratio;\n    end\nend\n"
    totalNumOfObjs	    [5 0 0 0]
  }
