  codeblock {
    id			    854
    slsfobj		    150
    code		    "function new_gear = gearShiftLogic(vehicle_speed, throttle, shift_up_speeds, shift_down_speeds, gears, "
    "current_gear)\n    num_gears = sum(gears > 0);\n   \n    if current_gear == 0\n        current_gear = int8(1); % D"
    "efault to first gear\n    end\n    \n    % Define throttle levels (0% throttle, 50%, 100%)\n    throttle_levels = "
    "[0, 0.5, 1];\n    \n    % Interpolate shift speeds based on throttle level for the selected vehicle\n    up_th = i"
    "nterp1(throttle_levels, shift_up_speeds, throttle, 'linear', 'extrap');\n    down_th = interp1(throttle_levels, sh"
    "ift_down_speeds, throttle, 'linear', 'extrap');\n\n    % Ensure that up_th and down_th are scalars (if necessary, "
    "use indexing)\n    up_th = up_th(current_gear);  % Get the specific threshold for the current gear\n    down_th = "
    "down_th(current_gear);  % Get the specific threshold for the current gear\n\n    % Upshift if speed exceeds thresh"
    "old and current gear is not the max gear\n    if vehicle_speed > up_th && current_gear < num_gears\n        curren"
    "t_gear = current_gear + 1;\n    end\n\n    % Downshift if speed drops below threshold and current gear is not the "
    "min gear\n    if vehicle_speed < down_th && current_gear > 1\n        current_gear = current_gear - 1;\n    end\n\n"
    "    % Output the new gear\n    new_gear = current_gear;\nend\n"
    totalNumOfObjs	    [4 4 2 0]
  }
  metric {
    id			    855
  }
