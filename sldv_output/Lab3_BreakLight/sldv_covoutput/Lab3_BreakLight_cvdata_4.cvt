  codeblock {
    id			    741
    slsfobj		    136
    code		    "function gear_ratio = getGearRatio(active_gear, gear_ratios, rev_ratio)  \n    num_gears = sum(gear_rat"
    "ios > 0);\n\n    % Return the selected gear ratio\n    if (active_gear == -1) \n        gear_ratio = rev_ratio;\n "
    "   elseif (active_gear == 0)\n        gear_ratio = 0; \n    elseif (active_gear <= num_gears)\n        gear_ratio "
    "= gear_ratios(active_gear);\n    else\n        gear_ratio = 0;\n    end\nend\n"
    totalNumOfObjs	    [4 0 0 0]
  }
